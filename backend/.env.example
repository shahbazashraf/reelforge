# Backend environment variables
# Copy this to .env and fill in values

SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Optional: Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# ── LLM Configuration ──────────────────────────────────────────────────
# SMART FALLBACK:
# 1. If OPENAI_API_KEY is set → uses gpt-4o-mini for script generation
# 2. If only OPENROUTER_API_KEY is set → uses free Llama model
# 3. If neither → uses free OpenRouter Llama (rate-limited)

# Option A: OpenAI API (paid, ~$0.01 per script)
OPENAI_API_KEY=sk-proj-...

# Option B: OpenRouter free tier (no payment)
OPENROUTER_API_KEY=

# Optionally override the model (leave blank for smart selection)
LLM_MODEL=

# Provider selection
LLM_PROVIDER=openai

# For Ollama local inference
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# For DeepSeek
DEEPSEEK_API_KEY=

# ── Image Generation ──────────────────────────────────────────────────
IMAGE_PROVIDER=openai
IMAGE_MODEL=dall-e-3

# ── Text-to-Speech ────────────────────────────────────────────────────
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
