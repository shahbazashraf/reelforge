# .env.example — copy to .env and fill in your keys

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/reelforge
REDIS_URL=redis://localhost:6379/0

# ── LLM (choose one) ──────────────────────────────────────
LLM_PROVIDER=openai           # openai | ollama | deepseek
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
OLLAMA_URL=http://localhost:11434
DEEPSEEK_API_KEY=

# ── Image generation (choose one) ─────────────────────────
IMAGE_PROVIDER=openai         # openai | flux | aliyun
IMAGE_MODEL=dall-e-3
ALIYUN_API_KEY=

# ── TTS (choose one) ──────────────────────────────────────
TTS_PROVIDER=edge             # edge (free) | elevenlabs | coqui
ELEVENLABS_API_KEY=

# ── Social Platforms ──────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── File Storage ───────────────────────────────────────────
MEDIA_DIR=/tmp/reelforge_media
OUTPUT_DIR=/tmp/reelforge_outputs
# Later: S3_BUCKET=your-bucket  AWS_ACCESS_KEY=  AWS_SECRET_KEY=

# ── Frontend ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── FFmpeg ─────────────────────────────────────────────────
FFMPEG_BIN=ffmpeg             # or full path: /usr/local/bin/ffmpeg
