# ============================================================
# ReelForge — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── App ───────────────────────────────────────────────────────────────────
# Your deployed URL (no trailing slash). Use http://localhost:3000 for local dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Supabase ──────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API
#
# 1. Go to https://supabase.com and create a free project
# 2. In your project dashboard go to Settings → API
# 3. Copy "Project URL" and "anon public" key below
# 4. Run the SQL in lib/schema.sql in your Supabase SQL Editor
# 5. In Storage, create two buckets: "media" (private) and "outputs" (private)
#    Set max file sizes: media=52428800 (50MB), outputs=524288000 (500MB)
# 6. Enable Google/GitHub OAuth in Authentication → Providers

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key — only used server-side, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── OpenAI (AI script, image generation) ─────────────────────────────────
# Get from: https://platform.openai.com/api-keys
# Required for: AI script generation, DALL-E image generation
# If you don't have OpenAI, set LLM_PROVIDER=ollama and run Ollama locally

OPENAI_API_KEY=sk-proj-...
# Model to use for script generation. gpt-4o-mini is cheapest, gpt-4o is best.
OPENAI_MODEL=gpt-4o-mini
# Image model. dall-e-3 is best quality, dall-e-2 is cheaper.
OPENAI_IMAGE_MODEL=dall-e-3


# ── LLM Provider (alternative to OpenAI) ─────────────────────────────────
# Options: "openai" | "ollama" | "deepseek"
LLM_PROVIDER=openai

# If using Ollama (free, runs locally):
# 1. Install: https://ollama.com
# 2. Run: ollama pull llama3.1 (or mistral, phi3, etc.)
# 3. Set LLM_PROVIDER=ollama and OLLAMA_MODEL below
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# If using DeepSeek (cheap alternative):
# Get key from: https://platform.deepseek.com
DEEPSEEK_API_KEY=


# ── TTS — Text to Speech ──────────────────────────────────────────────────
# Options: "edge" (free) | "elevenlabs" (premium)
TTS_PROVIDER=edge

# ElevenLabs (premium voices, very natural):
# Get key from: https://elevenlabs.io → Profile → API Key
# Free tier: 10,000 chars/month
ELEVENLABS_API_KEY=
# Voice ID — go to https://elevenlabs.io/voice-library and copy the ID
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Edge-TTS (completely free, runs via Python microservice):
# Install: pip install edge-tts
# Run alongside Next.js: edge-tts is called via the Python backend


# ── Python Backend (video rendering) ─────────────────────────────────────
# URL of the FastAPI backend (from previous phase).
# Run with: cd backend && uvicorn app.main:app --port 8000
BACKEND_URL=http://localhost:8000


# ── Social Platform OAuth ─────────────────────────────────────────────────
# Each platform requires creating a developer app.
# See README.md "Social OAuth Setup" section for step-by-step instructions.

# ── Instagram / Facebook ──────────────────────────────────────────────────
# 1. Go to https://developers.facebook.com → Create App → Business
# 2. Add products: "Facebook Login" and "Instagram Graph API"
# 3. In App Settings → Basic: copy App ID and App Secret
# 4. Add redirect URI: http://localhost:3000/api/social/instagram/callback
#    and: http://localhost:3000/api/social/facebook/callback
# 5. Request permissions: instagram_basic, instagram_content_publish,
#    pages_manage_posts, pages_read_engagement, pages_show_list
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── TikTok ────────────────────────────────────────────────────────────────
# 1. Go to https://developers.tiktok.com → Manage apps → Create app
# 2. Add product: "Login Kit" and "Content Posting API"
# 3. In app settings copy Client key and Client secret
# 4. Add redirect URI: http://localhost:3000/api/social/tiktok/callback
# 5. Request scopes: user.info.basic, video.publish, video.upload
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Twitter / X ───────────────────────────────────────────────────────────
# 1. Go to https://developer.twitter.com/en/portal/dashboard
# 2. Create a project and app (need Elevated or Basic access)
# 3. In app settings → User authentication settings:
#    - App type: Web App
#    - Callback URI: http://localhost:3000/api/social/twitter/callback
#    - Website URL: http://localhost:3000
# 4. Enable OAuth 2.0 with scopes: tweet.write, tweet.read, users.read, offline.access
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ── YouTube / Google ──────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable "YouTube Data API v3"
# 3. Credentials → Create OAuth 2.0 Client ID → Web application
# 4. Add authorized redirect URI: http://localhost:3000/api/social/youtube/callback
# 5. Download credentials and copy Client ID and Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Snapchat ──────────────────────────────────────────────────────────────
# 1. Go to https://kit.snapchat.com/manage
# 2. Create an app → Add "Login Kit"
# 3. Add redirect URI: http://localhost:3000/api/social/snapchat/callback
# 4. Copy Client ID and Secret
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
